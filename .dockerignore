# Version Control
.git
.gitignore

# Dependencies
node_modules
**/node_modules

# Build artifacts
dist
**/dist

# Local SQLite databases & runtime data
data
**/data
*.db
*.db-wal
*.db-shm
*.db-journal
app_pre_import_*.db

# Local environment and secret files
.env
.env.local
# 仅保留受版本控制的生产模板；其他 .env.<environment> 文件可能包含密钥。
.env.*
!.env.production.example
backend/.env
frontend/.env

# TLS assets are mounted into Nginx at runtime; never include them in an image build context.
nginx/ssl/*.key
nginx/ssl/*.crt
nginx/ssl/*.pem
nginx/ssl/*.p12
nginx/ssl/*.pfx

# Editor & IDE files
.vscode
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Documentation and temporary files
docs
scratch
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Release packaging outputs
release
*.tar
*.tar.gz
