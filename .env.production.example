# ========================================================
# Sacred Focus 生产环境配置模板 (.env.production)
# 部署前请复制为 .env 并根据实际情况修改安全密钥
# ========================================================

# 仅宿主机本地维护端口；它只映射到容器固定的 3000 端口，不会传入应用进程。
# 公网访问必须使用 Nginx 组合编排的 80/443。
PORT=3000

# 镜像版本号标签（必须与 docker-pack 产出的 sacred-focus:v<版本> 一致）
APP_VERSION=v1.0.0

# 容器业务日与日志时区；请在 Compose 与宿主计划任务中保持一致。
TZ=Asia/Shanghai

# 多项目共用服务器时的 Sacred Focus 资源上限。默认值适合轻量 Node + SQLite 负载，
# 并会给宿主机及其他项目留出空间；APP_MEMORY_SWAP_LIMIT 与 APP_MEMORY_LIMIT 相同表示不额外使用 Swap。
APP_MEMORY_LIMIT=512m
APP_MEMORY_RESERVATION=128m
APP_MEMORY_SWAP_LIMIT=512m
APP_CPU_LIMIT=0.75
APP_PIDS_LIMIT=200
NODE_HEAP_LIMIT_MB=384

# Nginx 网关资源上限（同样不额外使用 Swap）。
NGINX_MEMORY_LIMIT=128m
NGINX_MEMORY_RESERVATION=32m
NGINX_MEMORY_SWAP_LIMIT=128m
NGINX_CPU_LIMIT=0.25
NGINX_PIDS_LIMIT=100

# 生产环境 JWT 安全密钥（【必须配置】长度至少 32 字符且禁止使用默认/示例占位符）
# 建议通过命令生成: openssl rand -base64 32
JWT_SECRET=<GENERATE_HIGH_ENTROPY_JWT_SECRET_MIN_32_CHARS>

# 初始管理员访问密码（【必须配置】建议长度至少 12 字符，包含字母与数字）
ADMIN_PASSWORD=<SET_STRONG_ADMIN_PASSWORD_MIN_12_CHARS>

# 个人账号只在服务器创建；总数包含停用账号，admin/public 不占用名额。
MAX_PERSONAL_ACCOUNTS=20
# 每个工作区的 SQLite 容量上限（MB）；备份文件另占磁盘空间。
PUBLIC_DATA_LIMIT_MB=50
PERSONAL_DATA_LIMIT_MB=256

# 可信内网 IP 白名单（逗号分隔，只豁免安全扫描与限流，不授予个人账号身份）
# 公网部署通常留空
TRUSTED_IPS=

# 允许跨域请求来源（逗号分隔，Docker 一体化同源访问通常无需修改）。
# 使用 Nginx TLS 网关时，请改为实际 https 域名，例如 https://focus.example.com。
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 宿主机数据持久化存储目录（相对于 docker-compose.yml 所在路径）
HOST_DATA_DIR=./data

# 正式 TLS 证书目录（仓库外，内含 server.crt 与 server.key；仅 Nginx 组合编排需要）
NGINX_SSL_DIR=/etc/sacred-focus/tls
