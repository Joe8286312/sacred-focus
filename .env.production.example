# ========================================================
# Sacred Focus 生产环境配置模板 (.env.production)
# 部署前请复制为 .env 并根据实际情况修改安全密钥
# ========================================================

# 容器对外映射端口（宿主机访问端口）
PORT=3000

# 镜像版本号标签（用于 docker-compose 镜像版本管理）
APP_VERSION=1.0.0

# 生产环境 JWT 安全密钥（【必须修改】长度至少 32 字符且不得包含 change_in_production）
# 建议通过命令生成: openssl rand -base64 32
JWT_SECRET=SacredFocus_Production_Secure_JWT_Key_2026_ChangeMeImmediately!

# 默认初始管理员密码（首次初始化后建议登录控制台修改）
ADMIN_PASSWORD=SacredFocus@Admin2026

# 可信内网 IP 白名单（逗号分隔，处于此白名单的请求免登录，例如: 127.0.0.1,192.168.1.50）
# 若不需要免密直连请留空
TRUSTED_IPS=

# 允许跨域请求来源（逗号分隔，Docker 一体化同源访问通常无需修改）
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 宿主机数据持久化存储目录（相对于 docker-compose.yml 所在路径）
HOST_DATA_DIR=./data
