# Sacred Focus 后端环境变量配置模板
NODE_ENV=development
PORT=3000
DATA_DIR=./data

# JWT 签名密钥（生产环境务必替换为长随机字符串）
JWT_SECRET=sacred_focus_dev_jwt_secret_key_change_in_production_2026

# 初始管理员默认密码（首次启动或重置时使用，生产环境请修改）
ADMIN_PASSWORD=admin123456

MAX_PERSONAL_ACCOUNTS=20
PUBLIC_DATA_LIMIT_MB=50
PERSONAL_DATA_LIMIT_MB=256

# 可信 IP 仅豁免安全扫描与限流；不会自动登录个人工作区。
# TRUSTED_IPS=192.168.1.100,10.0.0.1
